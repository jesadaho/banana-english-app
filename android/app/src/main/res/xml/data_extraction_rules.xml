<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12 / API >= 31).
  Exclude Flutter SharedPreferences so a reinstall or device transfer starts
  fresh (onboarding flow runs again, a new anonymous user id is generated).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
